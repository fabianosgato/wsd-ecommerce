# Node artifact files
wsd-ecommerce/node_modules/
wsd-ecommerce/dist/
wsd-ecommerce/vendor/
wsd-ecommerce/public/build/
wsd-ecommerce/public/vendor/
wsd-ecommerce/public/tmp/
wsd-ecommerce/bootstrap/cache/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
